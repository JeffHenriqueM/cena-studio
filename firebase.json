{
  "hosting": {
    "target": "cena-studio",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/*.md",
      ".git/**",
      ".gitignore",
      ".nojekyll",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
